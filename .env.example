# ==============================================================================
# Self-Healing Text-to-SQL Analytics Agent - Root Environment Configuration
# ==============================================================================
# Copy this file to .env before running docker-compose or local setup:
#   Windows:      Copy-Item .env.example .env
#   Linux/macOS:  cp .env.example .env
# ==============================================================================

# Groq Cloud API Key (Get a free key from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Symmetric Encryption Key for Connection Credentials (Fernet 32 url-safe base64 bytes)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank in local development, an auto-generated development key will be used.
ENCRYPTION_KEY=your_fernet_key_or_leave_blank_for_auto_dev_key

# Database Execution Guardrails & Defaults
DATABASE_TIMEOUT_SECONDS=10
DEFAULT_ROW_LIMIT=500
MAX_RETRIES=3
SCHEMA_CACHE_TTL_SECONDS=900
AUTO_SEED_DEMO=true
DEMO_DB_FILENAME=demo_ecommerce.db

# Dynamic Connection Pool Configuration
SQL_POOL_SIZE=5
SQL_MAX_OVERFLOW=10
SQL_POOL_TIMEOUT=30

# API Gateway & Frontend Configuration
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
