# Groq Cloud API Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Security & Encryption (Fernet Key - 32 url-safe base64-encoded bytes)
# Run `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` to generate
ENCRYPTION_KEY=your_fernet_key_or_leave_blank_for_auto_dev_key

# Database Guardrails & Execution
DATABASE_TIMEOUT_SECONDS=10
DEFAULT_ROW_LIMIT=500
MAX_RETRIES=3
SCHEMA_CACHE_TTL_SECONDS=900

# Connection Pooling
SQL_POOL_SIZE=5
SQL_MAX_OVERFLOW=10
SQL_POOL_TIMEOUT=30

# API Gateway & CORS
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
